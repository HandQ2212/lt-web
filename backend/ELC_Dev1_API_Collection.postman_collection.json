{
  "info": {
    "name": "ELC Backend API - DEV 1",
    "description": "API collection for DEV 1 features: Authentication, Profile, Notifications, Announcements, and User Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "disabled": true
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lead@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"John Doe\",\n  \"phone\": \"0123456789\",\n  \"dateOfBirth\": \"2000-01-01\",\n  \"gender\": \"Male\",\n  \"address\": \"123 Main St\",\n  \"branchId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Public self-registration. Default role: LEAD. Manager can change role later via /api/users/{id}"
          },
          "response": []
        },
        {
          "name": "1.2 Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate user and return JWT tokens"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", jsonData.accessToken);",
                  "console.log(\"Token saved:\", jsonData.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Invalidate refresh token"
          },
          "response": []
        },
        {
          "name": "1.4 Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"your_refresh_token_here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Get new access token using refresh token"
          },
          "response": []
        },
        {
          "name": "1.5 Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Send password reset email (returns 200 OK even if email not found - security)"
          },
          "response": []
        },
        {
          "name": "1.6 Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"reset-token-from-email\",\n  \"newPassword\": \"newPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Update password using reset token from email"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Profile Management",
      "item": [
        {
          "name": "2.1 Get Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile"]
            },
            "description": "Get current authenticated user profile"
          },
          "response": []
        },
        {
          "name": "2.2 Update Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Updated\",\n  \"phone\": \"0987654321\",\n  \"dateOfBirth\": \"2000-01-15\",\n  \"gender\": \"Male\",\n  \"address\": \"456 New Address\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile"]
            },
            "description": "Update personal profile information. fullName is required."
          },
          "response": []
        },
        {
          "name": "2.3 Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"oldPassword123\",\n  \"newPassword\": \"newPassword456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/profile/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile", "password"]
            },
            "description": "Change current password (must verify old password)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Admin User Management (MANAGER ONLY)",
      "item": [
        {
          "name": "3.1 List All Users",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=0&size=20&sort=fullName,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "fullName,asc"
                }
              ]
            },
            "description": "List all users with pagination. Requires MANAGER role."
          },
          "response": []
        },
        {
          "name": "3.2 Get User By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "123e4567-e89b-12d3-a456-426614174000",
                  "description": "User UUID"
                }
              ]
            },
            "description": "Get specific user details by ID. Requires MANAGER role."
          },
          "response": []
        },
        {
          "name": "3.3 Create User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"teacherPass123\",\n  \"fullName\": \"Jane Smith\",\n  \"phone\": \"0123456789\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"gender\": \"Female\",\n  \"address\": \"789 Teacher St\",\n  \"role\": \"TEACHER\",\n  \"branchId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Create new user account (staff/teacher). Requires MANAGER role. Role options: STUDENT, TEACHER, ACCOUNTANT, MANAGER. Default: STUDENT if not specified."
          },
          "response": []
        },
        {
          "name": "3.4 Update User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"TEACHER\",\n  \"status\": \"ACTIVE\",\n  \"fullName\": \"Jane Updated\",\n  \"phone\": \"0999999999\",\n  \"address\": \"New Address\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "123e4567-e89b-12d3-a456-426614174000",
                  "description": "User UUID"
                }
              ]
            },
            "description": "Update user role, status, or info. Requires MANAGER role. Status options: ACTIVE, INACTIVE, DEACTIVATED. Role options: MANAGER, TEACHER, STUDENT, ACCOUNTANT, LEAD."
          },
          "response": []
        },
        {
          "name": "3.5 Deactivate User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "123e4567-e89b-12d3-a456-426614174000",
                  "description": "User UUID"
                }
              ]
            },
            "description": "Soft-delete user (sets status to INACTIVE). Requires MANAGER role."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Notifications",
      "item": [
        {
          "name": "4.1 Get My Notifications",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Get paginated list of current user's notifications"
          },
          "response": []
        },
        {
          "name": "4.2 Get Unread Count",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/unread-count",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "unread-count"]
            },
            "description": "Get count of unread notifications"
          },
          "response": []
        },
        {
          "name": "4.3 Mark as Read",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/{{notificationId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", ":notificationId", "read"],
              "variable": [
                {
                  "key": "notificationId",
                  "value": "123e4567-e89b-12d3-a456-426614174000",
                  "description": "Notification UUID"
                }
              ]
            },
            "description": "Mark specific notification as read"
          },
          "response": []
        },
        {
          "name": "4.4 Mark All as Read",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "read-all"]
            },
            "description": "Mark all notifications as read"
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Announcements",
      "item": [
        {
          "name": "5.1 Get Announcements",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/announcements?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "announcements"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Get active announcements (paginated)"
          },
          "response": []
        },
        {
          "name": "5.2 Create Announcement (MANAGER/TEACHER/ACCOUNTANT)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Holiday Schedule\",\n  \"message\": \"Center will be closed from Dec 25-27.\",\n  \"type\": \"INFO\",\n  \"scope\": \"CENTER\",\n  \"targetRole\": null,\n  \"targetClassId\": null,\n  \"expiresAt\": \"2024-12-31T23:59:59Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/announcements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "announcements"]
            },
            "description": "Create new announcement. Requires MANAGER, TEACHER, or ACCOUNTANT role. Type options: URGENT, INFO, PROMO. Scope options: CENTER, ROLE, CLASS, FINANCE."
          },
          "response": []
        }
      ]
    }
  ]
}
